# ── Required — LiveKit project credentials ───────────────────────────────────
# Get these from https://cloud.livekit.io/projects → Settings → Keys
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=<your-api-key>
LIVEKIT_API_SECRET=<your-api-secret>

# ── Voice Agent & Business Tools ─────────────────────────────────────────────
# Agent name registered with LiveKit Cloud (must match frontend NEXT_PUBLIC_AGENT_NAME)
AGENT_NAME=iccha-agent
LOG_LEVEL=INFO

# Google Places API (for shop name, location, and review verification)
GOOGLE_PLACES_API_KEY=

# Unsplash API (for curated hero shop photography)
UNSPLASH_ACCESS_KEY=

# ── Speech & LLM Providers ───────────────────────────────────────────────────
# Groq — LLM reasoning & fast Whisper STT
GROQ_API_KEY=

# Deepgram — Vernacular STT (Nova-3 multilingual)
DEEPGRAM_API_KEY=

# Cartesia — Real-time expressive TTS
CARTESIA_API_KEY=

# Smallest.ai — Indian accented TTS (Lightning / Waves)
SMALLEST_AI_API_KEY=

# AssemblyAI — STT benchmarking (Universal-3.5 Pro direct API)
ASSEMBLYAI_API_KEY=
