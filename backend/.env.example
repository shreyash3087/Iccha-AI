# ── Required — LiveKit project credentials ───────────────────────────────────
# Get these from https://cloud.livekit.io/projects → Settings → Keys
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=<your-api-key>
LIVEKIT_API_SECRET=<your-api-secret>

# ── Phase 2 Benchmark API Keys (all optional — missing keys skip that provider)

# AssemblyAI — STT benchmarking (Universal-3.5 Pro direct API)
# Free 100hr/month: https://www.assemblyai.com
ASSEMBLYAI_API_KEY=

# Cartesia — TTS benchmarking (Sonic-3 direct API)
# Get key at: https://play.cartesia.ai/keys
CARTESIA_API_KEY=

# Groq — LLM benchmarking (Llama 3.3 70B, Gemma2 9B)
# Free tier: https://console.groq.com
GROQ_API_KEY=

# Deepgram — STT benchmarking (Nova-3 multi)
# Free tier: https://console.deepgram.com
DEEPGRAM_API_KEY=

# Smallest.ai — TTS benchmarking (Lightning voice)
# You already have credits: https://waves.smallest.ai
SMALLEST_AI_API_KEY=

# ── Phase 3+ API Keys ─────────────────────────────────────────────────────────
# Google Places API (business lookup — leave blank until Phase 3)
GOOGLE_PLACES_API_KEY=

# ── Optional overrides (defaults shown) ──────────────────────────────────────
# AGENT_NAME=iccha-agent
# LOG_LEVEL=INFO
