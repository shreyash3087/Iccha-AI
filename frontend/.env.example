# ── LiveKit Cloud Credentials ──────────────────────────────────────────────────
# Server-side ONLY (never exposed to browser)
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# LiveKit SFU URL (public)
NEXT_PUBLIC_LIVEKIT_URL=wss://<your-project>.livekit.cloud

# Agent dispatch name — must match backend AGENT_NAME
NEXT_PUBLIC_AGENT_NAME=iccha-agent

# ── Groq API Key (for Voice Edit Whisper STT & LLM + Vision OCR Fallback) ──────
GROQ_API_KEY=your_groq_api_key

# ── Supabase Cloud Database & Auth ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_or_publishable_key

# ── Optional External APIs (for hero photos & location verification) ───────────
UNSPLASH_ACCESS_KEY=your_unsplash_access_key
GOOGLE_PLACES_API_KEY=your_google_places_api_key
GOOGLE_API_KEY=your_google_api_key
