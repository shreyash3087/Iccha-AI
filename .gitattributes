# Normalize line endings: LF in repo, native on checkout
* text=auto eol=lf

# Force binary — never mangle these
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.webp binary

# Lock files — treat as text but don't diff them
uv.lock -diff
package-lock.json -diff
